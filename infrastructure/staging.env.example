# Arcadence STAGING environment template (Phase 15.3)
# Copy to `.env` next to docker-compose.staging.yml and fill in real values.
# `.env` is machine-local and MUST NEVER be committed.
# Variable inventory + classification: docs/ENVIRONMENT.md

# ---- compose / infrastructure ------------------------------------------------
# Public API hostname Caddy will serve (no scheme): e.g. api.staging.example.com
API_HOST=api.staging.example.com
# Image tag = git SHA of the built images (reproducible deploys/rollbacks)
API_IMAGE_TAG=SET_TO_GIT_SHA
# API_IMAGE / WORKER_IMAGE: set only if you use a registry prefix,
# e.g. ghcr.io/your-org/arcadence-api (worker defaults to the same tag)

# ---- browser-facing origins --------------------------------------------------
# The Vercel frontend origin (invite links + OAuth callback redirects)
APP_ORIGIN=https://your-app.vercel.app

# ---- database (Supabase staging project kryxwfjaafcedtqruges) ----------------
# Use the Supabase POOLER (transaction mode, port 6543) — see staging spec §5.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- JWT verification (Supabase staging) --------------------------------------
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- credential encryption -----------------------------------------------------
# Fresh 32-byte base64 key for staging (`openssl rand -base64 32`).
# Losing it makes stored mailbox credentials undecryptable.
EMAIL_ENCRYPTION_KEY=

# ---- optional capabilities (staging) --------------------------------------------
# Google/Microsoft OAuth console credentials — callback URIs per staging spec §8
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.staging.example.com/api/v1/email-connections/oauth/google/callback
MSFT_OAUTH_CLIENT_ID=
MSFT_OAUTH_CLIENT_SECRET=
MSFT_OAUTH_REDIRECT_URI=https://api.staging.example.com/api/v1/email-connections/oauth/microsoft/callback
MSFT_OAUTH_TENANT=common

# AI provider (GLM) — without a key the AI endpoints return honest 503s
AI_API_KEY=
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_MODEL=glm-4.5-flash

# ---- deliberately NOT set on staging --------------------------------------------
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — billing dormant by product decision
# PLACEMENT_PROVIDER_KEY — deliverability placement tests off until wanted

# ---- worker tuning (defaults live in docker-compose.staging.yml) ----------------
# SENDING_ENABLED=false  (queue paused; flip only with owner authorization)
# TEST_RECIPIENT_ALLOWLIST=owner@yourdomain.com,tester@yourdomain.com
# WORKER_POLL_SECONDS=10
# WORKER_BATCH_SIZE=2
LOG_LEVEL=INFO
API_PORT=8080
