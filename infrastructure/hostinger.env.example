# Arcadence PRODUCTION (Hostinger VPS) environment template — Phase 15.6.
# Copy to `.env` beside docker-compose.hostinger.yml; fill in; `chmod 600 .env`.
# NEVER commit `.env`. Inventory + classification: docs/ENVIRONMENT.md.
#
# PRODUCTION SECRETS ARE NEW VALUES, NOT COPIES OF STAGING — especially
# EMAIL_ENCRYPTION_KEY and the database password (see migration plan §7).

# ---- compose / infrastructure -----------------------------------------------
APP_HOST=app.example.com          # browser-facing app origin (no scheme)
API_HOST=api.example.com          # public API origin (no scheme)
API_IMAGE_TAG=SET_TO_GIT_SHA      # pinned image tags = instant rollback
WEB_IMAGE_TAG=SET_TO_GIT_SHA      # web image (built per docs/HOSTINGER_MIGRATION.md §2)

# ---- browser-facing origins ---------------------------------------------------
APP_ORIGIN=https://app.example.com

# ---- database (Supabase PRODUCTION project — managed, stays in Supabase) ------
# Pooler endpoint (transaction mode, 6543). Production project credentials come
# from the owner's secret manager — never from chat or tickets.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- JWT verification (Supabase production) ------------------------------------
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- credential encryption ------------------------------------------------------
# FRESH production key (`openssl rand -base64 32`). Stored in the owner's
# secret manager; losing it makes stored mailbox credentials undecryptable.
EMAIL_ENCRYPTION_KEY=

# ---- OAuth callbacks (registered in Google / Microsoft consoles FIRST — §4) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/email-connections/oauth/google/callback
MSFT_OAUTH_CLIENT_ID=
MSFT_OAUTH_CLIENT_SECRET=
MSFT_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/email-connections/oauth/microsoft/callback
MSFT_OAUTH_TENANT=common

# ---- AI provider (optional until enabled) ---------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_MODEL=glm-4.5-flash

# ---- worker tuning (defaults live in docker-compose.hostinger.yml) ---------------
# SENDING_ENABLED=false  (queue paused until the owner explicitly enables)
# TEST_RECIPIENT_ALLOWLIST=
LOG_LEVEL=INFO
API_PORT=8080

# ---- deliberately NOT set at launch -----------------------------------------------
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — monetization deferred (product decision)
# PLACEMENT_PROVIDER_KEY — placement tests off until wanted
