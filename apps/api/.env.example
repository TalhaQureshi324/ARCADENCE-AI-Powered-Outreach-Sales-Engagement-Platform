# Arcadence API process — copy to .env.local and fill in real values.
# NEVER put real secret keys in this file or commit .env files.
# See docs/SECURITY.md for the secrets policy.

# HTTP port for the API process (validated to [1, 65535])
API_PORT=8080

# Per-caller API request limit per minute (sliding window)
RATE_LIMIT_PER_MINUTE=120

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Postgres connection string for Doobie.
# Local Supabase stack (default credentials are public knowledge):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Staging/production: direct connection from the Supabase dashboard
# (postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres)

# Supabase JWT verification (activates in Phase 1).
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=<project-ref>
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Credential encryption key (AES-256-GCM): base64 of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
# Required since Phase 2.1 — the API refuses to start without it.
EMAIL_ENCRYPTION_KEY=<openssl rand -base64 32>
