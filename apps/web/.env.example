# Arcadence Web (Next.js) — copy to .env.local and fill in real values.
# ONLY public configuration may live in NEXT_PUBLIC_* variables.
# Never place Supabase secret/service-role keys here or anywhere in the frontend.
# See docs/SECURITY.md.

# Scala API base URL used by browser calls
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Used from Phase 0.3 (Supabase) onward — placeholders only ----------------
# Supabase project URL (public)
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/publishable key (public — safe for the browser by design)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional capability flag: shows "Continue with Google" sign-in when the
# Supabase Google auth provider is configured (docs/MANUAL_SETUP.md 5c)
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=
