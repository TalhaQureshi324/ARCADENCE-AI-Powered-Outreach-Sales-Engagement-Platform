# Arcadence Worker process — copy to .env.local and fill in real values.
# NEVER put real secret keys in this file or commit .env files.

# Heartbeat interval in milliseconds (must be a positive integer)
WORKER_TICK_INTERVAL_MS=30000

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Postgres connection string for Doobie (direct/session-pooled for long-lived workers).
# Local Supabase stack (default credentials are public knowledge):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
